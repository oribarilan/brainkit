{
  "name": "@2brain/brainkit",
  "version": "0.10.0",
  "description": "An augmentation kit for your brain",
  "keywords": [
    "opencode-plugin",
    "second-brain",
    "para-method"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oribarilan/brainkit.git"
  },
  "bin": {
    "brainkit": "dist/cli/index.js"
  },
  "exports": {
    "./server": {
      "import": "./opencode/server.ts"
    },
    "./tui": {
      "import": "./opencode/tui.tsx"
    }
  },
  "files": [
    "dist/",
    "core/",
    "!core/__tests__/",
    "opencode/",
    "skills/",
    "scripts/",
    "claude/"
  ],
  "scripts": {
    "prepack": "rm -rf dist && npx tsc --project cli/tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "smol-toml": "^1.3.1"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
