{
  "name": "@oribish/brainkit",
  "version": "0.1.0",
  "description": "Second brain plugin for OpenCode - capture, organize, and retrieve knowledge with PARA method",
  "keywords": [
    "opencode-plugin",
    "second-brain",
    "para-method"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oribarilan/brainkit"
  },
  "bin": {
    "brainkit": "./dist/cli/index.js"
  },
  "exports": {
    "./server": {
      "import": "./opencode/server.ts"
    },
    "./tui": {
      "import": "./opencode/tui.tsx"
    }
  },
  "files": [
    "dist/",
    "opencode/",
    "skills/"
  ],
  "workspaces": [
    "core"
  ],
  "scripts": {
    "prepack": "npx tsc --project cli/tsconfig.json"
  },
  "dependencies": {
    "@oribish/brainkit-core": "workspace:*"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
